{
  "examples": [
    {
      "id": "ex-001",
      "description": "Close window when rain sensor detects rain",
      "user_request": "When it rains, automatically close all windows",
      "output": {
        "template_id": "rain-window-close-v1",
        "name": "Rain-triggered window close",
        "domain": "smart-home",
        "version": "0.1.0",
        "trigger": {
          "device_type": "rain_sensor",
          "capability": "rain_detection",
          "condition": "rain_detected == true",
          "threshold": null
        },
        "action": {
          "device_type": "smart_window",
          "capability": "position_control",
          "command": "close",
          "parameters": {
            "target_position": 0
          }
        },
        "state_machine": {
          "states": [
            "idle",
            "running",
            "success",
            "failure"
          ],
          "transitions": [
            {
              "from": "idle",
              "to": "running",
              "on": "trigger_fired"
            },
            {
              "from": "running",
              "to": "success",
              "on": "command_ack"
            },
            {
              "from": "running",
              "to": "failure",
              "on": "timeout_or_error"
            },
            {
              "from": "success",
              "to": "idle",
              "on": "reset"
            },
            {
              "from": "failure",
              "to": "idle",
              "on": "reset"
            }
          ]
        },
        "interruption_rule": {
          "condition": "manual_override == true",
          "action": "pause_and_notify"
        },
        "safety_constraints": [
          "do_not_close_if_person_detected_in_window_path"
        ],
        "priority": 70
      }
    }
  ]
}